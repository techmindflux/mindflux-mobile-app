# Copy this file to .env and fill in your values.
# The .env file is gitignored and will never be committed.

# Anthropic API key — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Gmail address used to SEND the email (must match the app password below)
GMAIL_SENDER=your.address@gmail.com

# Gmail App Password (NOT your regular password).
# Generate one at: https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be enabled on the account)
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Gmail address that will RECEIVE the digest (can be the same as GMAIL_SENDER)
GMAIL_RECIPIENT=your.address@gmail.com

# Set to "true" to write digest_preview.html instead of sending an email.
# Useful for testing the output before enabling the cron job.
DRY_RUN=false
